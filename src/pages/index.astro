---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import notepad from '../assets/icons8-notepad-24.png'
---

<Layout title='Welcome to my portfolio'>
	<main class="bg-mint-500">
		<div class="text-red-500 font-bold">Si ves este texto rojo, Tailwind funciona 🎉</div>
		<div class="grid grid-cols-2 md:grid-cols-4">
			<div class="bg-red-200 gap-x-10">holaaaaaaa</div>
			<div class="bg-red-200 gap-x-10">holaaaaaaa</div>
			<div class="bg-red-200 gap-x-10">holaaaaaaa</div>
			<div class="bg-red-200 gap-x-10">holaaaaaaa</div>
		</div>
		<div class="bg-white dark:bg-gray-700 rounded-lg px-6 py-8 ring shadow-xl ring-gray-900/5">
			<div>
			  <span class="inline-flex items-center justify-center rounded-md bg-indigo-500 p-2 shadow-lg">
				
				<img class="w-6 h-6  stroke-white self-center" src={ notepad.src } alt="notepad">
			  </span>
			</div>
			<h3 class="text-gray-900 dark:text-white mt-5 text-base font-medium tracking-tight ">Writes upside-down</h3>
			<p class="text-gray-500 dark:text-gray-400 mt-2 text-sm ">
			  The Zero Gravity Pen can be used to write in any orientation, including upside-down. It even works in outer space.
			</p>
		  </div>
	</main>
</Layout>
